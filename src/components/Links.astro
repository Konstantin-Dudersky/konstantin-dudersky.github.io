---
export interface Item {
    label: string;
    download: string;
    link: string;
}

interface Props {
    links: Item[];
}
const { links } = Astro.props;
---

<!-- Пример вызова:
<Links
    links={[
        {
            label: "DS3231M даташит",
            download: "/datasheets/DS3231M.pdf",
            link: "https://www.analog.com/en/products/ds3231m.html",
        },
        {
            label: "RK3506B даташит",
            download: "/datasheets/RK3506B.pdf",
            link: "https://github.com/LuckfoxTECH/Luckfox-Lyra-docs",
        },
    ]}
/> -->
<style>
    table {
        width: 100%;
    }

    table td:first-child,
    table th:first-child {
        width: 100%;
    }
</style>

<table>
    {links.map((item) => (
        <tr>
            <td>{item.label}</td>
            <td>
                <a href={item.download}>Скачать</a>
            </td>
            <td>
                <a href={item.link}>Ссылка</a>
            </td>
        </tr>
    ))}
</table>
